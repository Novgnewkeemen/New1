-- ฟังก์ชันการทำงาน (LOGIC)
---------------------------------------------------------

-- สลับการซ่อน/แสดงเมนูเมื่อกดปุ่มวงกลม
mainButton.MouseButton1Click:Connect(function()
    menuFrame.Visible = not menuFrame.Visible
end)

-- ฟังก์ชันดึง Character
local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:FindFirstChild("HumanoidRootPart")
end

-- 1. ฟังก์ชันบิน/วาร์ปไปตรงกลางอีเวนท์ใต้ทะเล
btnFlyToEvent.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    if not hrp then return end

    -- ** หมายเหตุ: ปรับพิกัด Vector3(X, Y, Z) ให้ตรงกับตำแหน่งจุดศูนย์กลางอีเวนท์ในแมพ Raise Animals 2 **
    local eventCenterPosition = Vector3.new(0, -50, 200) 

    -- ใช้ TweenService เพื่อให้ตัวละครค่อยๆ บิน/เคลื่อนที่ลอยไปอย่างราบรื่น (ลดโอกาสโดน Anti-Cheat ดึงกลับ)
    local tweenInfo = TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(eventCenterPosition)})
    tween:Play()
end)

-- 2. ฟังก์ชันวาร์ปไปเก็บโทเคนเปลือกหอย
btnCollectShells.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    if not hrp then return end

    -- ค้นหาวัตถุที่มีชื่อเกี่ยวกับเปลือกหอยใน Workspace
    -- (โปรดเปลี่ยนชื่อ "ShellToken" เป็นชื่อ Model/Part เปลือกหอยจริงในแมพ)
    local targetName = "ShellToken" 
    local foundShells = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == targetName and (obj:IsA("BasePart") or obj:IsA("Model")) then
            table.insert(foundShells, obj)
        end
    end

    if #foundShells > 0 then
        -- วาร์ปไปยังเปลือกหอยชิ้นแรกที่พบ
        local targetPart = foundShells[1]:IsA("Model") and foundShells[1].PrimaryPart or foundShells[1]
        if targetPart then
            hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        end
    else
        warn("ไม่พบโทเคนเปลือกหอยในบริเวณนี้")
    end
end)
